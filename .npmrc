# Dependency-audit posture for deployment. The release gate runs an explicit
# low-threshold production audit and must pass before any release state changes.

# No advisory summary during `npm install` / `npm ci`:
audit=false

# A direct `npm audit` uses the same strict threshold as the release gate.
audit-level=low

# Quiet the funding nag during install:
fund=false

# Only reviewed, version-pinned dependency lifecycle scripts may run. A new or
# upgraded package with an install script must be reviewed before npm ci succeeds.
allow-scripts=@swc/core@1.13.2,electron-winstaller@5.4.0,esbuild@0.25.12
strict-allow-scripts=true
